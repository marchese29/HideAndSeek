#!/usr/bin/env bash
# Pre-commit hook: models → core → worker → reconciler → server → openapi → api-types → mobile
#
# Uses cached hashes of staged content so steps are skipped when
# nothing has changed since the last successful run.

# Beads: flush pending changes to JSONL before commit
if command -v bd >/dev/null 2>&1; then
    bd hooks run pre-commit "$@" || exit 1
fi

CACHE_DIR="$(git rev-parse --git-dir)/hooks-cache"

# Run a command only if staged files under one or more paths have changed
# since the last successful run of that step.
#
# Usage: run_if_changed <cache_key> <skip_msg> <run_msg> <command> <path...>
#
# Paths are listed AFTER the command. The grep pattern and git diff pathspec
# are built from all trailing arguments.
#
# Returns the command's exit code, or 0 if skipped.
run_if_changed() {
    local cache_key="$1" skip_msg="$2" run_msg="$3" cmd="$4"
    shift 4
    local paths=("$@")

    # Build grep pattern: "^path1/\|^path2/"
    local grep_pattern=""
    for p in "${paths[@]}"; do
        [ -n "$grep_pattern" ] && grep_pattern+='\|'
        grep_pattern+="^${p}"
    done

    if ! git diff --cached --name-only | grep -q "$grep_pattern"; then
        return 0
    fi

    local hash_file="$CACHE_DIR/$cache_key"
    local current_hash
    current_hash=$(git diff --cached -- "${paths[@]}" | shasum -a 256 | cut -d' ' -f1)

    if [ -f "$hash_file" ] && [ "$(cat "$hash_file")" = "$current_hash" ]; then
        echo "$skip_msg"
        return 0
    fi

    echo "$run_msg"
    if "$cmd"; then
        mkdir -p "$CACHE_DIR"
        echo "$current_hash" > "$hash_file"
        return 0
    else
        return $?
    fi
}

# --- Models checks ---
run_if_changed "models-checks" \
    "Models checks passed on this content — skipping." \
    "Models code changed — running checks..." \
    hooks/models-checks.sh \
    "models/" || exit 1

# --- Core checks (also triggered by models changes — core depends on models) ---
run_if_changed "core-checks" \
    "Core checks passed on this content — skipping." \
    "Core code changed — running checks..." \
    hooks/core-checks.sh \
    "core/" "models/" || exit 1

# --- Worker checks (also triggered by models/core changes — worker depends on both) ---
run_if_changed "worker-checks" \
    "Worker checks passed on this content — skipping." \
    "Worker code changed — running checks..." \
    hooks/worker-checks.sh \
    "worker/" "core/" "models/" || exit 1

# --- Reconciler checks (also triggered by models/core/worker changes — reconciler depends on all three) ---
run_if_changed "reconciler-checks" \
    "Reconciler checks passed on this content — skipping." \
    "Reconciler code changed — running checks..." \
    hooks/reconciler-checks.sh \
    "reconciler/" "worker/" "core/" "models/" || exit 1

# --- Server checks (also triggered by models/core/worker changes — server depends on all three) ---
run_if_changed "server-checks" \
    "Server checks passed on this content — skipping." \
    "Server code changed — running checks..." \
    hooks/server-checks.sh \
    "server/" "models/" "core/" "worker/" || exit 1

# --- OpenAPI spec regen (also triggered by models changes) ---
run_if_changed "openapi-regen" \
    "OpenAPI spec already up to date — skipping regen." \
    "Regenerating OpenAPI spec..." \
    hooks/openapi-regen.sh \
    "server/" "models/" "core/" || exit 1

# --- API types regen (OpenAPI → TypeScript) ---
run_if_changed "api-types-regen" \
    "API types already up to date — skipping." \
    "Regenerating API types from OpenAPI spec..." \
    hooks/api-types-regen.sh \
    "openapi/" || exit 1

# --- Mobile checks ---
run_if_changed "mobile-checks" \
    "Mobile checks passed on this content — skipping." \
    "Mobile code changed — running checks..." \
    hooks/mobile-checks.sh \
    "mobile/" || exit 1
