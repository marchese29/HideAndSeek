# HideAndSeek CDK deploy-time env vars — template.
# Copy to `.env` and fill in values. `.env` is gitignored.
# Load before `cdk deploy`:  set -a; source infra/cdk/.env; set +a

# --- PushStack (HideAndSeek-Push) -------------------------------------------

# APNs — from Apple Developer Portal + AWS Secrets Manager
# Secrets Manager secret holding the .p8 signing key contents:
APNS_CREDENTIAL_SECRET_ARN=arn:aws:secretsmanager:<region>:<account>:secret:hideandseek/apns-signing-key-XXXXXX
# 10-char Key ID from Apple Dev Portal → Keys:
APNS_SIGNING_KEY_ID=XXXXXXXXXX
# 10-char Team ID from Apple Dev Portal membership page:
APNS_TEAM_ID=XXXXXXXXXX
# iOS bundle identifier registered in Apple Dev Portal:
APNS_BUNDLE_ID=dev.example.yourapp

# FCM — from Firebase Console + AWS Secrets Manager
# Secrets Manager secret holding the Firebase service-account JSON:
FCM_CREDENTIAL_SECRET_ARN=arn:aws:secretsmanager:<region>:<account>:secret:hideandseek/fcm-service-account-XXXXXX
