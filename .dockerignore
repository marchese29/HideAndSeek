# Only send what the Dockerfile needs
*

# Workspace root
!pyproject.toml
!uv.lock

# Models package
!models/pyproject.toml
!models/src/

# Core package
!core/pyproject.toml
!core/src/

# Worker package
!worker/pyproject.toml
!worker/src/

# Reconciler package
!reconciler/pyproject.toml
!reconciler/src/

# Server package
!server/pyproject.toml
!server/src/
!server/scripts/
# CDK's DockerImageAsset stages the build context before invoking docker,
# so the Dockerfile itself must survive the ignore filter. (Docker-compose
# reads the Dockerfile from disk directly, so it works either way.)
!server/Dockerfile

# Alembic migrations (run by the migrate one-shot in compose + ECS)
!alembic.ini
!alembic/
